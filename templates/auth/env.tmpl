JWT_SECRET="generate-a-secure-secret-minimum-32-chars-long"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"
BCRYPT_COST=12
{{if eq .Hasher "argon2id"}}
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
{{end}}
{{if eq .Strategy "session"}}
SESSION_SECRET="generate-a-secure-session-secret"
SESSION_EXPIRATION="24h"
{{else if eq .Strategy "api-key"}}
API_KEY_HEADER="X-API-Key"
MASTER_API_KEY="generate-a-master-api-key"
{{end}}
