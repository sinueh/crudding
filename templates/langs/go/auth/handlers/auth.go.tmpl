func (h *AuthHandler) Register(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	var req schemas.RegisterRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, `{"error": "dados inválidos"}`, http.StatusBadRequest)
		return
	}
	if req.Email == "" || !strings.Contains(req.Email, "@") || len(req.Password) < 8 {
		http.Error(w, `{"error": "email inválido ou senha fraca"}`, http.StatusBadRequest)
		return
	}
	if _, exists := h.findUserByEmail(req.Email); exists {
		http.Error(w, `{"error": "email já cadastrado"}`, http.StatusConflict)
		return
	}
	hash, _ := security.HashPassword(req.Password)
	role := req.Role
	if role == "" {
		role = "user"
	}
	now := time.Now().UTC()
	user := &models.User{
		ID:           uuid.New().String(),
		Email:        req.Email,
		PasswordHash: hash,
		Role:         role,
		CreatedAt:    now,
		UpdatedAt:    now,
	}
	_ = h.saveUser(user)
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusCreated)
	_ = json.NewEncoder(w).Encode(schemas.UserResponse{
		ID:        user.ID,
		Email:     user.Email,
		Role:      user.Role,
		CreatedAt: user.CreatedAt,
	})
}

