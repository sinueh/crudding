func (h *AuthHandler) Register(c *gin.Context) {
	var req schemas.RegisterRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "dados de cadastro inválidos"})
		return
	}
	if req.Email == "" || !strings.Contains(req.Email, "@") || len(req.Password) < 8 {
		c.JSON(http.StatusBadRequest, gin.H{"error": "email inválido ou senha com menos de 8 caracteres"})
		return
	}
	if _, exists := h.findUserByEmail(req.Email); exists {
		c.JSON(http.StatusConflict, gin.H{"error": "email já cadastrado"})
		return
	}
	hash, err := security.HashPassword(req.Password)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "falha ao processar senha"})
		return
	}
	role := req.Role
	if role == "" {
		role = "user"
	}
	now := time.Now().UTC()
	user := &models.User{
		ID:           uuid.New().String(),
		Email:        req.Email,
		PasswordHash: hash,
		Role:         role,
		CreatedAt:    now,
		UpdatedAt:    now,
	}
	if err := h.saveUser(user); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "falha ao salvar usuário"})
		return
	}
	c.JSON(http.StatusCreated, schemas.UserResponse{
		ID:        user.ID,
		Email:     user.Email,
		Role:      user.Role,
		CreatedAt: user.CreatedAt,
	})
}

func (h *AuthHandler) Login(c *gin.Context) {
	var req schemas.LoginRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "dados de login inválidos"})
		return
	}
	user, exists := h.findUserByEmail(req.Email)
	if !exists || !security.CheckPasswordHash(req.Password, user.PasswordHash) {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "credenciais inválidas"})
		return
	}
	token, exp, err := h.tokens.GenerateAccessToken(user.ID, user.Email, user.Role)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "falha ao gerar token"})
		return
	}
	res := schemas.AuthResponse{
		AccessToken: token,
		TokenType:   "Bearer",
		ExpiresIn:   exp,
	}
{{if .HasRefresh}}	refreshToken, _ := h.tokens.GenerateRefreshToken()
	res.RefreshToken = refreshToken
{{end}}	c.JSON(http.StatusOK, res)
}

