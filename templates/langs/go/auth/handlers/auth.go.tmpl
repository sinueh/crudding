type AuthHandler struct {
	tokens     *security.TokenService
	middleware *middlewares.AuthMiddleware
	db         *sql.DB
	usersMu    sync.RWMutex
	users      map[string]*models.User // in-memory fallback
}

func NewAuthHandler(tokens *security.TokenService, middleware *middlewares.AuthMiddleware, dbs ...*sql.DB) *AuthHandler {
	var db *sql.DB
	if len(dbs) > 0 {
		db = dbs[0]
	}
	return &AuthHandler{
		tokens:     tokens,
		middleware: middleware,
		db:         db,
		users:      make(map[string]*models.User),
	}
}

func (h *AuthHandler) saveUser(u *models.User) error {
	if h.db != nil {
		_, err := h.db.Exec(
			"INSERT INTO users (id, email, password_hash, role, created_at, updated_at) VALUES ($1, $2, $3, $4, $5, $6)",
			u.ID, u.Email, u.PasswordHash, u.Role, u.CreatedAt, u.UpdatedAt,
		)
		if err == nil {
			return nil
		}
	}
	h.usersMu.Lock()
	defer h.usersMu.Unlock()
	h.users[u.Email] = u
	return nil
}

func (h *AuthHandler) findUserByEmail(email string) (*models.User, bool) {
	if h.db != nil {
		row := h.db.QueryRow("SELECT id, email, password_hash, role, created_at, updated_at FROM users WHERE email = $1", email)
		var u models.User
		if err := row.Scan(&u.ID, &u.Email, &u.PasswordHash, &u.Role, &u.CreatedAt, &u.UpdatedAt); err == nil {
			return &u, true
		}
	}
	h.usersMu.RLock()
	defer h.usersMu.RUnlock()
	u, ok := h.users[email]
	return u, ok
}

func (h *AuthHandler) findUserByID(id string) (*models.User, bool) {
	if h.db != nil {
		row := h.db.QueryRow("SELECT id, email, password_hash, role, created_at, updated_at FROM users WHERE id = $1", id)
		var u models.User
		if err := row.Scan(&u.ID, &u.Email, &u.PasswordHash, &u.Role, &u.CreatedAt, &u.UpdatedAt); err == nil {
			return &u, true
		}
	}
	h.usersMu.RLock()
	defer h.usersMu.RUnlock()
	for _, u := range h.users {
		if u.ID == id {
			return u, true
		}
	}
	return nil, false
}

