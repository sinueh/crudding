{
  "version": 1,
  "name": "go-fiber-hexagonal",
  "language": "go",
  "framework": "fiber",
  "architecture": "hexagonal",
  "endpoints": [
    "user"
  ],
  "endpoint": {
    "name": "user",
    "files": [
      "internal/domain/user.go.tmpl",
      "internal/domain/user_types.go.tmpl",
      "internal/ports/user_repository.go.tmpl",
      "internal/ports/user_service.go.tmpl",
      "internal/application/user.go.tmpl",
      "internal/adapters/postgres/user.go.tmpl",
      "internal/handlers/user.go.tmpl"
    ],
    "register": [
      "internal/routes/routes.go.tmpl"
    ]
  },
  "ignore": [],
  "directories": [
    "cmd",
    "cmd/api",
    "internal",
    "internal/adapters",
    "internal/adapters/postgres",
    "internal/application",
    "internal/config",
    "internal/domain",
    "internal/handlers",
    "internal/ports",
    "internal/routes"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "cmd/api/main.go.tmpl",
    "go.mod.tmpl",
    "go.sum",
    "internal/adapters/postgres/user.go.tmpl",
    "internal/application/user.go.tmpl",
    "internal/config/config.go.tmpl",
    "internal/domain/user.go.tmpl",
    "internal/domain/user_types.go.tmpl",
    "internal/handlers/user.go.tmpl",
    "internal/ports/user_repository.go.tmpl",
    "internal/ports/user_service.go.tmpl",
    "internal/routes/routes.go.tmpl"
  ]
}
