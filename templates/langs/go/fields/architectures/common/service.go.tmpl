func (s *{{.VarName}}Service) Create(req {{$tq}}Create{{.Class}}Request) ({{$tq}}{{.Class}}Response, error) {
	item := {{$mq}}{{.Class}}{
{{- range .Fields }}
		{{.Name}}: {{ if .Nullable }}req.{{.Name}}{{ else }}*req.{{.Name}}{{ end }},
{{- end }}
	}
	if err := s.insert(&item); err != nil {
		return {{$tq}}{{.Class}}Response{}, err
	}
	// Relê o registro para devolver os valores como o banco gravou (ex.: decimais).
	return s.GetByID(item.ID)
}

func (s *{{.VarName}}Service) List() ([]{{$tq}}{{.Class}}Response, error) {
	items, err := s.findAll()
	if err != nil {
		return nil, err
	}
	res := make([]{{$tq}}{{.Class}}Response, 0, len(items))
	for _, item := range items {
		res = append(res, s.response(item))
	}
	return res, nil
}

func (s *{{.VarName}}Service) GetByID(id uint) ({{$tq}}{{.Class}}Response, error) {
	item, err := s.find(id)
	if err != nil {
		return {{$tq}}{{.Class}}Response{}, err
	}
	return s.response(*item), nil
}

func (s *{{.VarName}}Service) Update(id uint, req {{$tq}}Update{{.Class}}Request) ({{$tq}}{{.Class}}Response, error) {
	item, err := s.find(id)
	if err != nil {
		return {{$tq}}{{.Class}}Response{}, err
	}
{{- template "go-apply" (dict "D" . "Item" "item") }}
	if err := s.save(item); err != nil {
		return {{$tq}}{{.Class}}Response{}, err
	}
	return s.GetByID(id)
}

func (s *{{.VarName}}Service) Delete(id uint) error {
	return s.remove(id)
}

