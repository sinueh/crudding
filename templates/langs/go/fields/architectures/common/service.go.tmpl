package application

import (
	"{{.GoModule}}/internal/domain"
	"{{.GoModule}}/internal/ports"
)

type {{.VarName}}Service struct {
	repo ports.{{.Class}}Repository
}

func New{{.Class}}Service(repo ports.{{.Class}}Repository) ports.{{.Class}}Service {
	return &{{.VarName}}Service{repo: repo}
}

func (s *{{.VarName}}Service) Create(req domain.Create{{.Class}}Request) (domain.{{.Class}}Response, error) {
	item := domain.{{.Class}}{
{{- range .Fields }}
		{{.Name}}: {{ if .Nullable }}req.{{.Name}}{{ else }}*req.{{.Name}}{{ end }},
{{- end }}
	}
	if err := s.repo.Create(&item); err != nil {
		return domain.{{.Class}}Response{}, err
	}
	return s.GetByID(item.ID)
}

func (s *{{.VarName}}Service) List() ([]domain.{{.Class}}Response, error) {
	items, err := s.repo.FindAll()
	if err != nil {
		return nil, err
	}
	res := make([]domain.{{.Class}}Response, 0, len(items))
	for _, item := range items {
		res = append(res, s.response(item))
	}
	return res, nil
}

func (s *{{.VarName}}Service) GetByID(id uint) (domain.{{.Class}}Response, error) {
	item, err := s.repo.FindByID(id)
	if err != nil {
		return domain.{{.Class}}Response{}, err
	}
	return s.response(*item), nil
}

func (s *{{.VarName}}Service) Update(id uint, req domain.Update{{.Class}}Request) (domain.{{.Class}}Response, error) {
	item, err := s.repo.FindByID(id)
	if err != nil {
		return domain.{{.Class}}Response{}, err
	}
{{- template "go-apply" (dict "D" . "Item" "item") }}
	if err := s.repo.Update(item); err != nil {
		return domain.{{.Class}}Response{}, err
	}
	return s.GetByID(id)
}

func (s *{{.VarName}}Service) Delete(id uint) error {
	return s.repo.Delete(id)
}

func (s *{{.VarName}}Service) response(item domain.{{.Class}}) domain.{{.Class}}Response {
	return domain.{{.Class}}Response{
		ID: item.ID,
{{- range .Fields }}
		{{.Name}}: item.{{.Name}},
{{- end }}
	}
}
