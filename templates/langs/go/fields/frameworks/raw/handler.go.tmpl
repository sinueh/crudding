{{- $h := include "handler" . }}{{ $tq := include "tq" . }}{{ $eq := include "errq" . -}}
package {{ template "pkg-handler" . }}

import (
	"encoding/json"
	"errors"
	"net/http"
	"strconv"

{{if eq .Architecture "layered"}}	"{{.GoModule}}/internal/service"
	"{{.GoModule}}/internal/types"
{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}	"{{.GoModule}}/internal/domain"
	"{{.GoModule}}/internal/ports"
{{end}})

type {{$h}} struct {
	svc {{ template "iface" . }}
}

func New{{$h}}(svc {{ template "iface" . }}) *{{$h}} {
	return &{{$h}}{svc: svc}
}

func (h *{{$h}}) write(w http.ResponseWriter, status int, body any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(body)
}

// fail responde 404, 409 ou 500 conforme o erro do service.
func (h *{{$h}}) fail(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, {{$eq}}{{ template "notfound" . }}):
		h.write(w, http.StatusNotFound, map[string]string{"error": "{{.VarName}} não encontrado"})
	case errors.Is(err, {{$eq}}{{ template "conflict" . }}):
		h.write(w, http.StatusConflict, map[string]string{"error": err.Error()})
	default:
		h.write(w, http.StatusInternalServerError, map[string]string{"error": "erro interno"})
	}
}

func (h *{{$h}}) id(w http.ResponseWriter, r *http.Request) (uint, bool) {
	id, err := strconv.ParseUint(r.PathValue("id"), 10, 64)
	if err != nil {
		h.write(w, http.StatusBadRequest, map[string]string{"error": "id inválido"})
		return 0, false
	}
	return uint(id), true
}

func (h *{{$h}}) Create(w http.ResponseWriter, r *http.Request) {
	var req {{$tq}}Create{{.Class}}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		h.write(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
		return
	}
	if err := req.Validate(); err != nil {
		h.write(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
		return
	}
	res, err := h.svc.Create(req)
	if err != nil {
		h.fail(w, err)
		return
	}
	h.write(w, http.StatusCreated, res)
}

func (h *{{$h}}) List(w http.ResponseWriter, r *http.Request) {
	res, err := h.svc.List()
	if err != nil {
		h.fail(w, err)
		return
	}
	h.write(w, http.StatusOK, res)
}

func (h *{{$h}}) GetByID(w http.ResponseWriter, r *http.Request) {
	id, ok := h.id(w, r)
	if !ok {
		return
	}
	res, err := h.svc.GetByID(id)
	if err != nil {
		h.fail(w, err)
		return
	}
	h.write(w, http.StatusOK, res)
}

func (h *{{$h}}) Update(w http.ResponseWriter, r *http.Request) {
	id, ok := h.id(w, r)
	if !ok {
		return
	}
	var req {{$tq}}Update{{.Class}}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		h.write(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
		return
	}
	if err := req.Validate(); err != nil {
		h.write(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
		return
	}
	res, err := h.svc.Update(id, req)
	if err != nil {
		h.fail(w, err)
		return
	}
	h.write(w, http.StatusOK, res)
}

func (h *{{$h}}) Delete(w http.ResponseWriter, r *http.Request) {
	id, ok := h.id(w, r)
	if !ok {
		return
	}
	if err := h.svc.Delete(id); err != nil {
		h.fail(w, err)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
