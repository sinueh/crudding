{{- /* Qualificadores e nomes que dependem da arquitetura. */ -}}
{{- define "tq" }}{{ if eq .Architecture "layered" }}types.{{ else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch") }}domain.{{ end }}{{ end -}}
{{- define "mq" }}{{ if eq .Architecture "layered" }}models.{{ else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch") }}domain.{{ end }}{{ end -}}
{{- define "handler" }}{{ if eq .Architecture "modular" }}Handler{{ else }}{{.Class}}Handler{{ end }}{{ end -}}
{{- define "svcname" }}{{ if eq .Architecture "modular" }}Service{{ else }}{{.Class}}Service{{ end }}{{ end -}}
{{- define "iface" }}{{ if eq .Architecture "layered" }}service.{{.Class}}Service{{ else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch") }}ports.{{.Class}}Service{{ else if eq .Architecture "flat" }}{{.Class}}Service{{ else }}Service{{ end }}{{ end -}}
{{- define "notfound" }}{{ if eq .Architecture "modular" }}ErrNotFound{{ else }}Err{{.Class}}NotFound{{ end }}{{ end -}}
{{- define "conflict" }}{{ if eq .Architecture "modular" }}ErrConflict{{ else }}Err{{.Class}}Conflict{{ end }}{{ end -}}
{{- define "errq" }}{{ if eq .Architecture "layered" }}service.{{ else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch") }}domain.{{ end }}{{ end -}}
{{- define "pkg-handler" }}{{ if eq .Architecture "modular" }}{{.Package}}{{ else if eq .Architecture "flat" }}main{{ else }}handlers{{ end }}{{ end -}}

{{- /* Variáveis de erro do endpoint. */ -}}
{{- define "go-errors" }}
var (
	{{ template "notfound" . }} = errors.New("{{.VarName}} não encontrado")
	{{ template "conflict" . }} = errors.New("{{.VarName}}: operação recusada pelo banco (referência inexistente ou registro em uso)")
)
{{- end -}}

{{- /* Validações comuns de Create<X>Request e Update<X>Request (campos ponteiro). */ -}}
{{- define "go-checks" }}
{{- range .Fields }}
{{- if .MaxLen }}
	if r.{{.GoName}} != nil && len(*r.{{.GoName}}) > {{.MaxLen}} {
		return errors.New("{{.Column}} deve ter no máximo {{.MaxLen}} caracteres")
	}
{{- end }}
{{- if .IsDate }}
	if r.{{.GoName}} != nil {
		if _, err := time.Parse("2006-01-02", *r.{{.GoName}}); err != nil {
			return errors.New("{{.Column}} deve estar no formato AAAA-MM-DD")
		}
	}
{{- end }}
{{- if .IsUUID }}
	if r.{{.GoName}} != nil && (len(*r.{{.GoName}}) != 36 || strings.Count(*r.{{.GoName}}, "-") != 4) {
		return errors.New("{{.Column}} deve ser um UUID")
	}
{{- end }}
{{- if .IsRef }}
	if r.{{.GoName}} != nil && *r.{{.GoName}} == 0 {
		return errors.New("{{.Column}} deve ser maior que zero")
	}
{{- end }}
{{- end }}
{{- end -}}

{{- /*
Armazenamento: métodos insert/findAll/find/save/remove no tipo .Recv, com
SQL (database/sql) quando o projeto tem postgres/mysql e um mapa em memória
quando o banco está fora do ar ou não existe.
Parâmetros (dict): D (dados), Recv (tipo), M (entidade), NotFound, Conflict.
*/ -}}
{{- define "go-store-fields" }}
{{- if eq .D.Endpoint.Store "sql" }}
	db     *sql.DB
{{- end }}
	mu     sync.RWMutex
	items  map[uint]{{.M}}
	nextID uint
{{- end -}}

{{- define "go-store-new" }}
{{- if eq .D.Endpoint.Store "sql" }}
	var db *sql.DB
	if len(dbs) > 0 {
		db = dbs[0]
	}
	return &{{.Recv}}{db: db, items: make(map[uint]{{.M}}), nextID: 1}
{{- else }}
	_ = dbs // {{ if .D.Database }}TODO: o crudding ainda não gera acesso a dados para {{.D.Database}}; os registros ficam em memória.{{ else }}projeto sem banco de dados: os registros ficam em memória.{{ end }}
	return &{{.Recv}}{items: make(map[uint]{{.M}}), nextID: 1}
{{- end }}
{{- end -}}

{{- define "go-store" }}
{{- $d := .D }}
{{- if eq $d.Endpoint.Store "sql" }}
// dbError troca a recusa de chave estrangeira do banco por {{.Conflict}}.
func (x *{{.Recv}}) dbError(err error) error {
	if err != nil && strings.Contains(strings.ToLower(err.Error()), "foreign key constraint") {
		return fmt.Errorf("%w: %v", {{.Conflict}}, err)
	}
	return err
}
{{- end }}

func (x *{{.Recv}}) insert(item *{{.M}}) error {
{{- if eq $d.Endpoint.Store "sql" }}
	if x.db != nil {
{{- if $d.Endpoint.SQL.Returning }}
		return x.dbError(x.db.QueryRow({{$d.Endpoint.SQL.Insert}}{{ range $d.Fields }}, item.{{.GoName}}{{ end }}).Scan(&item.ID))
{{- else }}
		res, err := x.db.Exec({{$d.Endpoint.SQL.Insert}}{{ range $d.Fields }}, item.{{.GoName}}{{ end }})
		if err != nil {
			return x.dbError(err)
		}
		id, err := res.LastInsertId()
		if err != nil {
			return err
		}
		item.ID = uint(id)
		return nil
{{- end }}
	}
{{ end }}
	x.mu.Lock()
	defer x.mu.Unlock()
	item.ID = x.nextID
	x.nextID++
	x.items[item.ID] = *item
	return nil
}

func (x *{{.Recv}}) findAll() ([]{{.M}}, error) {
{{- if eq $d.Endpoint.Store "sql" }}
	if x.db != nil {
		rows, err := x.db.Query({{$d.Endpoint.SQL.Select}})
		if err != nil {
			return nil, err
		}
		defer rows.Close()

		list := make([]{{.M}}, 0)
		for rows.Next() {
			var item {{.M}}
			if err := rows.Scan(&item.ID{{ range $d.Fields }}, &item.{{.GoName}}{{ end }}); err != nil {
				return nil, err
			}
			list = append(list, item)
		}
		return list, rows.Err()
	}
{{ end }}
	x.mu.RLock()
	defer x.mu.RUnlock()
	list := make([]{{.M}}, 0, len(x.items))
	for _, item := range x.items {
		list = append(list, item)
	}
	slices.SortFunc(list, func(a, b {{.M}}) int { return cmp.Compare(a.ID, b.ID) })
	return list, nil
}

func (x *{{.Recv}}) find(id uint) (*{{.M}}, error) {
{{- if eq $d.Endpoint.Store "sql" }}
	if x.db != nil {
		var item {{.M}}
		err := x.db.QueryRow({{$d.Endpoint.SQL.SelectOne}}, id).Scan(&item.ID{{ range $d.Fields }}, &item.{{.GoName}}{{ end }})
		if errors.Is(err, sql.ErrNoRows) {
			return nil, {{.NotFound}}
		}
		if err != nil {
			return nil, err
		}
		return &item, nil
	}
{{ end }}
	x.mu.RLock()
	defer x.mu.RUnlock()
	item, exists := x.items[id]
	if !exists {
		return nil, {{.NotFound}}
	}
	return &item, nil
}

func (x *{{.Recv}}) save(item *{{.M}}) error {
{{- if eq $d.Endpoint.Store "sql" }}
	if x.db != nil {
		if _, err := x.db.Exec({{$d.Endpoint.SQL.Update}}{{ range $d.Fields }}, item.{{.GoName}}{{ end }}, item.ID); err != nil {
			return x.dbError(err)
		}
		return nil
	}
{{ end }}
	x.mu.Lock()
	defer x.mu.Unlock()
	if _, exists := x.items[item.ID]; !exists {
		return {{.NotFound}}
	}
	x.items[item.ID] = *item
	return nil
}

func (x *{{.Recv}}) remove(id uint) error {
{{- if eq $d.Endpoint.Store "sql" }}
	if x.db != nil {
		res, err := x.db.Exec({{$d.Endpoint.SQL.Delete}}, id)
		if err != nil {
			return x.dbError(err)
		}
		if affected, err := res.RowsAffected(); err == nil && affected == 0 {
			return {{.NotFound}}
		}
		return nil
	}
{{ end }}
	x.mu.Lock()
	defer x.mu.Unlock()
	if _, exists := x.items[id]; !exists {
		return {{.NotFound}}
	}
	delete(x.items, id)
	return nil
}
{{- end -}}

{{- /* Imports do armazenamento. */ -}}
{{- define "go-store-imports" }}
	"cmp"
	"database/sql"
{{- if eq .Endpoint.Store "sql" }}
	"fmt"
	"strings"
{{- end }}
	"slices"
	"sync"
{{- end -}}

{{- /* Aplica os campos enviados no PATCH (dict: D, Item). */ -}}
{{- define "go-apply" }}
{{- $item := .Item }}
{{- range .D.Fields }}
	if req.{{.GoName}} != nil {
		{{$item}}.{{.GoName}} = {{ if .Nullable }}req.{{.GoName}}{{ else }}*req.{{.GoName}}{{ end }}
	}
{{- end }}
{{- end -}}
