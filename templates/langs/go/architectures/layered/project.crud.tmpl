{
  "version": 1,
  "name": "base-app",
  "language": "go",
  "framework": "{{.Framework}}",
  "architecture": "layered",
  "vars": {
    "GoModule": "example.com/{{.ProjectSlug}}",
    "Package": "template",
    "VarName": "template",
    "Class": "Template"
  },
  "endpoints": ["template"],
  "template_endpoint": {
    "name": "template",
    "files": [
      ".crudding/template/internal/models/template.go",
      ".crudding/template/internal/types/template.go",
      ".crudding/template/internal/service/template.go",
      ".crudding/template/internal/handlers/template.go"
    ],
    "register": [
      "internal/routes/routes.go"
    ]
  },
  "directories": [
    "cmd/api",
    "internal/config",
    "internal/handlers",
    "internal/models",
    "internal/routes",
    "internal/service",
    "internal/types"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/layered/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/go.mod.tmpl",
      "to": "go.mod"
    },
    {
      "from": "architectures/common/go.sum.tmpl",
      "to": "go.sum"
    },
    {
      "from": "frameworks/{{.Framework}}/main.go.tmpl",
      "to": "cmd/api/main.go"
    },
    {
      "from": "frameworks/{{.Framework}}/routes.go.tmpl",
      "to": "internal/routes/routes.go"
    },
    {
      "from": "frameworks/{{.Framework}}/handler.go.tmpl",
      "to": "internal/handlers/template.go"
    },
    {
      "from": "architectures/common/model.go.tmpl",
      "to": "internal/models/template.go"
    },
    {
      "from": "architectures/common/types.go.tmpl",
      "to": "internal/types/template.go"
    },
    {
      "from": "architectures/common/service.go.tmpl",
      "to": "internal/service/template.go"
    },
    {
      "from": "frameworks/{{.Framework}}/handler.go.tmpl",
      "to": ".crudding/template/internal/handlers/template.go"
    },
    {
      "from": "architectures/common/model.go.tmpl",
      "to": ".crudding/template/internal/models/template.go"
    },
    {
      "from": "architectures/common/types.go.tmpl",
      "to": ".crudding/template/internal/types/template.go"
    },
    {
      "from": "architectures/common/service.go.tmpl",
      "to": ".crudding/template/internal/service/template.go"
    },
    {
      "from": "architectures/common/config.go.tmpl",
      "to": "internal/config/config.go"
    }
  ]
}