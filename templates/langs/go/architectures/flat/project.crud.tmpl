{
  "version": 1,
  "name": "base-app",
  "language": "go",
  "framework": "{{.Framework}}",
  "architecture": "flat",
  "vars": {
    "GoModule": "example.com/{{.ProjectSlug}}",
    "Package": "template",
    "VarName": "template",
    "Class": "Template"
  },
  "endpoints": ["template"],
  "template_endpoint": {
    "name": "template",
    "files": [
      ".crudding/template/template_model.go",
      ".crudding/template/template_types.go",
      ".crudding/template/template_service.go",
      ".crudding/template/template_handler.go"
    ],
    "register": [
      "routes.go"
    ]
  },
  "directories": [
    "config"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/flat/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/go.mod.tmpl",
      "to": "go.mod"
    },
    {
      "from": "architectures/common/go.sum.tmpl",
      "to": "go.sum"
    },
    {
      "from": "frameworks/{{.Framework}}/main.go.tmpl",
      "to": "main.go"
    },
    {
      "from": "frameworks/{{.Framework}}/routes.go.tmpl",
      "to": "routes.go"
    },
    {
      "from": "frameworks/{{.Framework}}/handler.go.tmpl",
      "to": "template_handler.go"
    },
    {
      "from": "architectures/common/model.go.tmpl",
      "to": "template_model.go"
    },
    {
      "from": "architectures/common/types.go.tmpl",
      "to": "template_types.go"
    },
    {
      "from": "architectures/common/service.go.tmpl",
      "to": "template_service.go"
    },
    {
      "from": "frameworks/{{.Framework}}/handler.go.tmpl",
      "to": ".crudding/template/template_handler.go"
    },
    {
      "from": "architectures/common/model.go.tmpl",
      "to": ".crudding/template/template_model.go"
    },
    {
      "from": "architectures/common/types.go.tmpl",
      "to": ".crudding/template/template_types.go"
    },
    {
      "from": "architectures/common/service.go.tmpl",
      "to": ".crudding/template/template_service.go"
    },
    {
      "from": "architectures/common/config.go.tmpl",
      "to": "config/config.go"
    }
  ]
}