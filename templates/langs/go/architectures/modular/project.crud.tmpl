{
  "version": 1,
  "name": "base-app",
  "language": "go",
  "framework": "{{.Framework}}",
  "architecture": "modular",
  "vars": {
    "GoModule": "example.com/{{.ProjectSlug}}",
    "Package": "user",
    "VarName": "user",
    "Class": "User"
  },
  "endpoints": ["user"],
  "endpoint": {
    "name": "user",
    "files": [
      "internal/user/model.go",
      "internal/user/types.go",
      "internal/user/service.go",
      "internal/user/handler.go"
    ],
    "register": [
      "internal/routes/routes.go"
    ]
  },
  "directories": [
    "cmd/api",
    "internal/config",
    "internal/routes",
    "internal/user"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/modular/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/go.mod.tmpl",
      "to": "go.mod"
    },
    {
      "from": "architectures/common/go.sum.tmpl",
      "to": "go.sum"
    },
    {
      "from": "frameworks/{{.Framework}}/main.go.tmpl",
      "to": "cmd/api/main.go"
    },
    {
      "from": "frameworks/{{.Framework}}/routes.go.tmpl",
      "to": "internal/routes/routes.go"
    },
    {
      "from": "frameworks/{{.Framework}}/handler.go.tmpl",
      "to": "internal/user/handler.go"
    },
    {
      "from": "architectures/common/model.go.tmpl",
      "to": "internal/user/model.go"
    },
    {
      "from": "architectures/common/types.go.tmpl",
      "to": "internal/user/types.go"
    },
    {
      "from": "architectures/common/service.go.tmpl",
      "to": "internal/user/service.go"
    },
    {
      "from": "architectures/common/config.go.tmpl",
      "to": "internal/config/config.go"
    }
  ]
}