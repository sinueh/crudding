package service

import (
	"errors"
	"sync"
	"time"

	"example.com/go-raw-layered/internal/models"
	"example.com/go-raw-layered/internal/types"
)

var (
	ErrUserNotFound = errors.New("user não encontrado")
)

type UserService interface {
	Create(req types.CreateUserRequest) (types.UserResponse, error)
	List() ([]types.UserResponse, error)
	GetByID(id uint) (types.UserResponse, error)
	Delete(id uint) error
}

type userService struct {
	mu     sync.RWMutex
	items  map[uint]models.User
	nextID uint
}

func NewUserService() UserService {
	return &userService{
		items:  make(map[uint]models.User),
		nextID: 1,
	}
}

func (s *userService) Create(req types.CreateUserRequest) (types.UserResponse, error) {
	s.mu.Lock()
	defer s.mu.Unlock()

	item := models.User{
		ID:        s.nextID,
		Name:      req.Name,
		Email:     req.Email,
		Password:  req.Password,
		CreatedAt: time.Now().UTC(),
	}
	s.nextID++
	s.items[item.ID] = item

	return types.UserResponse{
		ID:    item.ID,
		Name:  item.Name,
		Email: item.Email,
	}, nil
}

func (s *userService) List() ([]types.UserResponse, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	res := make([]types.UserResponse, 0, len(s.items))
	for _, item := range s.items {
		res = append(res, types.UserResponse{
			ID:    item.ID,
			Name:  item.Name,
			Email: item.Email,
		})
	}
	return res, nil
}

func (s *userService) GetByID(id uint) (types.UserResponse, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	item, exists := s.items[id]
	if !exists {
		return types.UserResponse{}, ErrUserNotFound
	}

	return types.UserResponse{
		ID:    item.ID,
		Name:  item.Name,
		Email: item.Email,
	}, nil
}

func (s *userService) Delete(id uint) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	if _, exists := s.items[id]; !exists {
		return ErrUserNotFound
	}
	delete(s.items, id)
	return nil
}

