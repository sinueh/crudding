package persistence

import (
	"errors"
	"sync"

	"example.com/go-raw-clean-arch/internal/domain"
	"example.com/go-raw-clean-arch/internal/ports"
)

var (
	ErrUserNotFound = errors.New("user não encontrado")
)

type userRepository struct {
	mu     sync.RWMutex
	items  map[uint]domain.User
	nextID uint
}

func NewUserRepository() ports.UserRepository {
	return &userRepository{
		items:  make(map[uint]domain.User),
		nextID: 1,
	}
}

func (r *userRepository) Create(user *domain.User) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	user.ID = r.nextID
	r.nextID++
	r.items[user.ID] = *user
	return nil
}

func (r *userRepository) FindAll() ([]domain.User, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	list := make([]domain.User, 0, len(r.items))
	for _, item := range r.items {
		list = append(list, item)
	}
	return list, nil
}

func (r *userRepository) FindByID(id uint) (*domain.User, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	item, exists := r.items[id]
	if !exists {
		return nil, ErrUserNotFound
	}
	return &item, nil
}

func (r *userRepository) Delete(id uint) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, exists := r.items[id]; !exists {
		return ErrUserNotFound
	}
	delete(r.items, id)
	return nil
}
