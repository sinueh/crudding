{
  "version": 1,
  "name": "go-raw-flat",
  "language": "go",
  "framework": "raw",
  "architecture": "flat",
  "endpoints": [
    "user"
  ],
  "endpoint": {
    "name": "user",
    "files": [
      "user_model.go.tmpl",
      "user_types.go.tmpl",
      "user_service.go.tmpl",
      "user_handler.go.tmpl"
    ],
    "register": [
      "routes.go.tmpl"
    ]
  },
  "ignore": [],
  "directories": [
    "config"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "config/config.go.tmpl",
    "go.mod.tmpl",
    "go.sum",
    "main.go.tmpl",
    "routes.go.tmpl",
    "user_handler.go.tmpl",
    "user_model.go.tmpl",
    "user_service.go.tmpl",
    "user_types.go.tmpl"
  ]
}
