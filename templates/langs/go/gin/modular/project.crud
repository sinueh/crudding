{
  "version": 1,
  "name": "go-gin-modular",
  "language": "go",
  "framework": "gin",
  "architecture": "modular",
  "endpoints": [
    "user"
  ],
  "endpoint": {
    "name": "user",
    "files": [
      "internal/user/model.go.tmpl",
      "internal/user/types.go.tmpl",
      "internal/user/service.go.tmpl",
      "internal/user/handler.go.tmpl"
    ],
    "register": [
      "internal/routes/routes.go.tmpl"
    ]
  },
  "ignore": [],
  "directories": [
    "cmd",
    "cmd/api",
    "internal",
    "internal/config",
    "internal/routes",
    "internal/user"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "cmd/api/main.go.tmpl",
    "go.mod.tmpl",
    "go.sum",
    "internal/config/config.go.tmpl",
    "internal/routes/routes.go.tmpl",
    "internal/user/handler.go.tmpl",
    "internal/user/model.go.tmpl",
    "internal/user/service.go.tmpl",
    "internal/user/types.go.tmpl"
  ]
}
