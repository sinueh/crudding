type MySQLConfig struct {
	DSN string
}

func loadMySQLConfig() MySQLConfig {
	dsn := os.Getenv("DATABASE_URL")
	if dsn == "" {
		dsn = fmt.Sprintf(
			"%s:%s@tcp(%s:%s)/%s?parseTime=true",
			getEnv("DB_USER", "user"),
			getEnv("DB_PASSWORD", "password"),
			getEnv("DB_HOST", "localhost"),
			getEnv("DB_PORT", "3306"),
			getEnv("DB_NAME", "app"),
		)
	}
	return MySQLConfig{DSN: dsn}
}

// ConnectMySQL estabelece e valida a conexão com o MySQL.
func ConnectMySQL(cfg MySQLConfig) (*sql.DB, error) {
	db, err := sql.Open("mysql", cfg.DSN)
	if err != nil {
		return nil, fmt.Errorf("abrir conexão com mysql: %w", err)
	}
	if err := db.Ping(); err != nil {
		return nil, fmt.Errorf("ping no mysql: %w", err)
	}
	return db, nil
}

// MigrateMySQL aplica os arquivos *.up.sql da pasta dir em ordem alfabética.
func MigrateMySQL(db *sql.DB, dir string) error {
	entries, err := os.ReadDir(dir)
	if err != nil {
		if os.IsNotExist(err) {
			return nil
		}
		return fmt.Errorf("ler migrações em %s: %w", dir, err)
	}
	var files []string
	for _, entry := range entries {
		if !entry.IsDir() && strings.HasSuffix(entry.Name(), ".up.sql") {
			files = append(files, entry.Name())
		}
	}
	slices.Sort(files)
	for _, name := range files {
		content, err := os.ReadFile(filepath.Join(dir, name))
		if err != nil {
			return fmt.Errorf("ler migração %s: %w", name, err)
		}
		for _, stmt := range strings.Split(string(content), ";") {
			if stmt = strings.TrimSpace(stmt); stmt != "" {
				if _, err := db.Exec(stmt); err != nil {
					return fmt.Errorf("aplicar migração %s: %w", name, err)
				}
			}
		}
	}
	return nil
}

