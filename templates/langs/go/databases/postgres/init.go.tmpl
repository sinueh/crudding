	if pgDB, err := config.ConnectPostgres(cfg.Postgres); err != nil {
		log.Printf("Aviso: postgres indisponível (%v); usando armazenamento em memória", err)
	} else {
		db = pgDB
		defer db.Close()
		if err := config.MigratePostgres(db, "migrations"); err != nil {
			log.Printf("Aviso: falha ao aplicar migrações no postgres: %v", err)
		}
	}
