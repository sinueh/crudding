{
  "version": 1,
  "name": "python-django-modular",
  "language": "python",
  "framework": "django",
  "architecture": "modular",
  "endpoints": [
    "resource"
  ],
  "endpoint": {
    "name": "resource",
    "files": [
      "src/app/resource/controller.py",
      "src/app/resource/service.py",
      "src/app/resource/models.py",
      "src/app/resource/__init__.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "ignore": [],
  "directories": [
    "src",
    "src/app",
    "src/app/config",
    "src/app/resource"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "requirements.txt",
    "src/__init__.py",
    "src/app/__init__.py",
    "src/app/config/__init__.py",
    "src/app/config/config.py",
    "src/app/main.py",
    "src/app/resource/__init__.py",
    "src/app/resource/controller.py",
    "src/app/resource/models.py",
    "src/app/resource/service.py"
  ]
}
