{
  "version": 1,
  "name": "python-flask-layered",
  "language": "python",
  "framework": "flask",
  "architecture": "layered",
  "endpoints": [
    "resource"
  ],
  "endpoint": {
    "name": "resource",
    "files": [
      "src/app/controllers/resource_controller.py",
      "src/app/services/resource_service.py",
      "src/app/models/resource.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "ignore": [],
  "directories": [
    "src",
    "src/app",
    "src/app/config",
    "src/app/controllers",
    "src/app/models",
    "src/app/services"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "requirements.txt",
    "src/__init__.py",
    "src/app/__init__.py",
    "src/app/config/__init__.py",
    "src/app/config/config.py",
    "src/app/controllers/__init__.py",
    "src/app/controllers/resource_controller.py",
    "src/app/main.py",
    "src/app/models/__init__.py",
    "src/app/models/resource.py",
    "src/app/services/__init__.py",
    "src/app/services/resource_service.py"
  ]
}
