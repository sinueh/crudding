{
  "version": 1,
  "name": "python-flask-hexagonal",
  "language": "python",
  "framework": "flask",
  "architecture": "hexagonal",
  "endpoints": [
    "resource"
  ],
  "endpoint": {
    "name": "resource",
    "files": [
      "src/app/routers/resource_controller.py",
      "src/app/application/resource_service.py",
      "src/app/ports/resource_repository.py",
      "src/app/infrastructure/resource_repository.py",
      "src/app/domain/resource.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "ignore": [],
  "directories": [
    "src",
    "src/app",
    "src/app/application",
    "src/app/config",
    "src/app/domain",
    "src/app/infrastructure",
    "src/app/ports",
    "src/app/routers"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "requirements.txt",
    "src/__init__.py",
    "src/app/__init__.py",
    "src/app/application/__init__.py",
    "src/app/application/resource_service.py",
    "src/app/config/__init__.py",
    "src/app/config/config.py",
    "src/app/domain/__init__.py",
    "src/app/domain/resource.py",
    "src/app/infrastructure/__init__.py",
    "src/app/infrastructure/resource_repository.py",
    "src/app/main.py",
    "src/app/ports/__init__.py",
    "src/app/ports/resource_repository.py",
    "src/app/routers/__init__.py",
    "src/app/routers/resource_controller.py"
  ]
}
