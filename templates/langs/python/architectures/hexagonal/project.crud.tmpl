{
  "version": 1,
  "name": "base-app",
  "language": "python",
  "framework": "{{.Framework}}",
  "architecture": "hexagonal",
  "vars": {
    "Name": "template",
    "Class": "Template",
    "Route": "template",
    "EntryModule": "src.app.main",
    "Modules": {
      "config": "src.app.config.config",
      "controller": "src.app.routers.template_controller",
      "service": "src.app.application.template_service",
      "port": "src.app.ports.template_repository",
      "adapter": "src.app.infrastructure.template_repository",
      "model": "src.app.domain.template"
    }
  },
  "endpoints": ["template"],
  "template_endpoint": {
    "name": "template",
    "files": [
      ".crudding/template/src/app/routers/template_controller.py",
      ".crudding/template/src/app/application/template_service.py",
      ".crudding/template/src/app/ports/template_repository.py",
      ".crudding/template/src/app/infrastructure/template_repository.py",
      ".crudding/template/src/app/domain/template.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "directories": [
    "src",
    "src/app",
    "src/app/application",
    "src/app/config",
    "src/app/domain",
    "src/app/infrastructure",
    "src/app/ports",
    "src/app/routers"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/hexagonal/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/requirements.txt.tmpl",
      "to": "requirements.txt"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/application/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/config/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/domain/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/infrastructure/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/ports/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/routers/__init__.py"
    },
    {
      "from": "architectures/common/config.py.tmpl",
      "to": "src/app/config/config.py"
    },
    {
      "from": "frameworks/{{.Framework}}/main.py.tmpl",
      "to": "src/app/main.py"
    },
    {
      "from": "frameworks/{{.Framework}}/controller.py.tmpl",
      "to": "src/app/routers/template_controller.py"
    },
    {
      "from": "architectures/hexagonal/service.py.tmpl",
      "to": "src/app/application/template_service.py"
    },
    {
      "from": "architectures/common/repository_port.py.tmpl",
      "to": "src/app/ports/template_repository.py"
    },
    {
      "from": "architectures/common/repository_adapter.py.tmpl",
      "to": "src/app/infrastructure/template_repository.py"
    },
    {
      "from": "architectures/common/model.py.tmpl",
      "to": "src/app/domain/template.py"
    },
    {
      "from": "frameworks/{{.Framework}}/controller.py.tmpl",
      "to": ".crudding/template/src/app/routers/template_controller.py"
    },
    {
      "from": "architectures/hexagonal/service.py.tmpl",
      "to": ".crudding/template/src/app/application/template_service.py"
    },
    {
      "from": "architectures/common/repository_port.py.tmpl",
      "to": ".crudding/template/src/app/ports/template_repository.py"
    },
    {
      "from": "architectures/common/repository_adapter.py.tmpl",
      "to": ".crudding/template/src/app/infrastructure/template_repository.py"
    },
    {
      "from": "architectures/common/model.py.tmpl",
      "to": ".crudding/template/src/app/domain/template.py"
    }
  ]
}