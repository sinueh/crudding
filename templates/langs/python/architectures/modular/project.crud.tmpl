{
  "version": 1,
  "name": "base-app",
  "language": "python",
  "framework": "{{.Framework}}",
  "architecture": "modular",
  "vars": {
    "Name": "user",
    "Class": "User",
    "Route": "user",
    "EntryModule": "src.app.main",
    "Modules": {
      "config": "src.app.config.config",
      "controller": "src.app.user.controller",
      "service": "src.app.user.service",
      "model": "src.app.user.models"
    }
  },
  "endpoints": ["user"],
  "endpoint": {
    "name": "user",
    "files": [
      "src/app/user/controller.py",
      "src/app/user/service.py",
      "src/app/user/models.py",
      "src/app/user/__init__.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "directories": [
    "src",
    "src/app",
    "src/app/config",
    "src/app/user"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/modular/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/requirements.txt.tmpl",
      "to": "requirements.txt"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/config/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/user/__init__.py"
    },
    {
      "from": "architectures/common/config.py.tmpl",
      "to": "src/app/config/config.py"
    },
    {
      "from": "frameworks/{{.Framework}}/main.py.tmpl",
      "to": "src/app/main.py"
    },
    {
      "from": "frameworks/{{.Framework}}/controller.py.tmpl",
      "to": "src/app/user/controller.py"
    },
    {
      "from": "architectures/common/model.py.tmpl",
      "to": "src/app/user/models.py"
    },
    {
      "from": "architectures/common/service.py.tmpl",
      "to": "src/app/user/service.py"
    }
  ]
}