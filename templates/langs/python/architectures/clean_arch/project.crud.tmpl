      ".crudding/template/src/app/interface_adapters/persistence/template_repository.py",
      ".crudding/template/src/app/domain/model/template.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "directories": [
    "src",
    "src/app",
    "src/app/application",
    "src/app/application/port",
    "src/app/application/port/outbound",
    "src/app/application/use_cases",
    "src/app/config",
