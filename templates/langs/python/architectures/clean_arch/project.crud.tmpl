{
  "version": 1,
  "name": "base-app",
  "language": "python",
  "framework": "{{.Framework}}",
  "architecture": "clean_arch",
  "vars": {
    "Name": "user",
    "Class": "User",
    "Route": "user",
    "EntryModule": "src.app.main",
    "Modules": {
      "config": "src.app.config.config",
      "controller": "src.app.frameworks_and_drivers.web.user_controller",
      "service": "src.app.interface_adapters.controllers.user_controller",
      "presenter": "src.app.interface_adapters.presenters.user_presenter",
      "create": "src.app.application.use_cases.create_user",
      "delete": "src.app.application.use_cases.delete_user",
      "get": "src.app.application.use_cases.get_user",
      "list": "src.app.application.use_cases.list_user",
      "update": "src.app.application.use_cases.update_user",
      "port": "src.app.application.port.outbound.user_repository",
      "adapter": "src.app.interface_adapters.persistence.user_repository",
      "model": "src.app.domain.model.user"
    }
  },
  "endpoints": ["user"],
  "endpoint": {
    "name": "user",
    "files": [
      "src/app/frameworks_and_drivers/web/user_controller.py",
      "src/app/interface_adapters/controllers/user_controller.py",
      "src/app/interface_adapters/presenters/user_presenter.py",
      "src/app/application/use_cases/create_user.py",
      "src/app/application/use_cases/delete_user.py",
      "src/app/application/use_cases/get_user.py",
      "src/app/application/use_cases/list_user.py",
      "src/app/application/use_cases/update_user.py",
      "src/app/application/port/outbound/user_repository.py",
      "src/app/interface_adapters/persistence/user_repository.py",
      "src/app/domain/model/user.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "directories": [
    "src",
    "src/app",
    "src/app/application",
    "src/app/application/port",
    "src/app/application/port/outbound",
    "src/app/application/use_cases",
    "src/app/config",
    "src/app/domain",
    "src/app/domain/model",
    "src/app/frameworks_and_drivers",
    "src/app/frameworks_and_drivers/web",
    "src/app/interface_adapters",
    "src/app/interface_adapters/controllers",
    "src/app/interface_adapters/persistence",
    "src/app/interface_adapters/presenters"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/clean_arch/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/requirements.txt.tmpl",
      "to": "requirements.txt"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/config/__init__.py"
    },
    {
      "from": "architectures/common/config.py.tmpl",
      "to": "src/app/config/config.py"
    },
    {
      "from": "frameworks/{{.Framework}}/main.py.tmpl",
      "to": "src/app/main.py"
    },
    {
      "from": "frameworks/{{.Framework}}/controller.py.tmpl",
      "to": "src/app/frameworks_and_drivers/web/user_controller.py"
    },
    {
      "from": "architectures/clean_arch/controller.py.tmpl",
      "to": "src/app/interface_adapters/controllers/user_controller.py"
    },
    {
      "from": "architectures/clean_arch/presenter.py.tmpl",
      "to": "src/app/interface_adapters/presenters/user_presenter.py"
    },
    {
      "from": "architectures/clean_arch/create.py.tmpl",
      "to": "src/app/application/use_cases/create_user.py"
    },
    {
      "from": "architectures/clean_arch/delete.py.tmpl",
      "to": "src/app/application/use_cases/delete_user.py"
    },
    {
      "from": "architectures/clean_arch/get.py.tmpl",
      "to": "src/app/application/use_cases/get_user.py"
    },
    {
      "from": "architectures/clean_arch/list.py.tmpl",
      "to": "src/app/application/use_cases/list_user.py"
    },
    {
      "from": "architectures/clean_arch/update.py.tmpl",
      "to": "src/app/application/use_cases/update_user.py"
    },
    {
      "from": "architectures/common/repository_port.py.tmpl",
      "to": "src/app/application/port/outbound/user_repository.py"
    },
    {
      "from": "architectures/common/repository_adapter.py.tmpl",
      "to": "src/app/interface_adapters/persistence/user_repository.py"
    },
    {
      "from": "architectures/common/model.py.tmpl",
      "to": "src/app/domain/model/user.py"
    }
  ]
}