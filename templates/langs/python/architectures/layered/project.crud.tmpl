{
  "version": 1,
  "name": "base-app",
  "language": "python",
  "framework": "{{.Framework}}",
  "architecture": "layered",
  "vars": {
    "Name": "template",
    "Class": "Template",
    "Route": "template",
    "EntryModule": "src.app.main",
    "Modules": {
      "config": "src.app.config.config",
      "controller": "src.app.controllers.template_controller",
      "service": "src.app.services.template_service",
      "model": "src.app.models.template"
    }
  },
  "endpoints": ["template"],
  "template_endpoint": {
    "name": "template",
    "files": [
      ".crudding/template/src/app/controllers/template_controller.py",
      ".crudding/template/src/app/services/template_service.py",
      ".crudding/template/src/app/models/template.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "directories": [
    "src",
    "src/app",
    "src/app/config",
    "src/app/controllers",
    "src/app/models",
    "src/app/services"
  ],
  "files": [
    {
      "from": "architectures/common/.gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "architectures/layered/README.md.tmpl",
      "to": "README.md"
    },
    {
      "from": "frameworks/{{.Framework}}/requirements.txt.tmpl",
      "to": "requirements.txt"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/config/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/controllers/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/models/__init__.py"
    },
    {
      "from": "architectures/common/__init__.py.tmpl",
      "to": "src/app/services/__init__.py"
    },
    {
      "from": "architectures/common/config.py.tmpl",
      "to": "src/app/config/config.py"
    },
    {
      "from": "frameworks/{{.Framework}}/main.py.tmpl",
      "to": "src/app/main.py"
    },
    {
      "from": "frameworks/{{.Framework}}/controller.py.tmpl",
      "to": "src/app/controllers/template_controller.py"
    },
    {
      "from": "architectures/common/model.py.tmpl",
      "to": "src/app/models/template.py"
    },
    {
      "from": "architectures/common/service.py.tmpl",
      "to": "src/app/services/template_service.py"
    },
    {
      "from": "frameworks/{{.Framework}}/controller.py.tmpl",
      "to": ".crudding/template/src/app/controllers/template_controller.py"
    },
    {
      "from": "architectures/common/model.py.tmpl",
      "to": ".crudding/template/src/app/models/template.py"
    },
    {
      "from": "architectures/common/service.py.tmpl",
      "to": ".crudding/template/src/app/services/template_service.py"
    }
  ]
}