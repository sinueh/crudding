{
  "version": 1,
  "name": "python-raw-clean_arch",
  "language": "python",
  "framework": "raw",
  "architecture": "clean_arch",
  "endpoints": [
    "resource"
  ],
  "endpoint": {
    "name": "resource",
    "files": [
      "src/app/frameworks_and_drivers/web/resource_controller.py",
      "src/app/interface_adapters/controllers/resource_controller.py",
      "src/app/interface_adapters/presenters/resource_presenter.py",
      "src/app/application/use_cases/create_resource.py",
      "src/app/application/use_cases/delete_resource.py",
      "src/app/application/use_cases/get_resource.py",
      "src/app/application/use_cases/list_resource.py",
      "src/app/application/use_cases/update_resource.py",
      "src/app/application/port/outbound/resource_repository.py",
      "src/app/interface_adapters/persistence/resource_repository.py",
      "src/app/domain/model/resource.py"
    ],
    "register": [
      "src/app/main.py"
    ]
  },
  "ignore": [],
  "directories": [
    "src",
    "src/app",
    "src/app/application",
    "src/app/application/port",
    "src/app/application/port/outbound",
    "src/app/application/use_cases",
    "src/app/config",
    "src/app/domain",
    "src/app/domain/model",
    "src/app/frameworks_and_drivers",
    "src/app/frameworks_and_drivers/web",
    "src/app/interface_adapters",
    "src/app/interface_adapters/controllers",
    "src/app/interface_adapters/persistence",
    "src/app/interface_adapters/presenters"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "requirements.txt",
    "src/__init__.py",
    "src/app/__init__.py",
    "src/app/application/__init__.py",
    "src/app/application/port/__init__.py",
    "src/app/application/port/outbound/__init__.py",
    "src/app/application/port/outbound/resource_repository.py",
    "src/app/application/use_cases/__init__.py",
    "src/app/application/use_cases/create_resource.py",
    "src/app/application/use_cases/delete_resource.py",
    "src/app/application/use_cases/get_resource.py",
    "src/app/application/use_cases/list_resource.py",
    "src/app/application/use_cases/update_resource.py",
    "src/app/config/__init__.py",
    "src/app/config/config.py",
    "src/app/domain/__init__.py",
    "src/app/domain/model/__init__.py",
    "src/app/domain/model/resource.py",
    "src/app/frameworks_and_drivers/__init__.py",
    "src/app/frameworks_and_drivers/web/__init__.py",
    "src/app/frameworks_and_drivers/web/resource_controller.py",
    "src/app/interface_adapters/__init__.py",
    "src/app/interface_adapters/controllers/__init__.py",
    "src/app/interface_adapters/controllers/resource_controller.py",
    "src/app/interface_adapters/persistence/__init__.py",
    "src/app/interface_adapters/persistence/resource_repository.py",
    "src/app/interface_adapters/presenters/__init__.py",
    "src/app/interface_adapters/presenters/resource_presenter.py",
    "src/app/main.py"
  ]
}
