{
  "name": "{{.ProjectSlug}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "{{if eq .Runtime "ts"}}tsx{{else}}node{{end}} {{.EntryScript}}",
    "dev": "{{if eq .Runtime "ts"}}tsx watch{{else}}node --watch{{end}} {{.EntryScript}}"{{if eq .Architecture "flat"}},
    "test": "{{if eq .Runtime "ts"}}tsx --test src/tasks.test.ts{{else}}node --test src/tasks.test.js{{end}}"{{end}}{{if eq .Runtime "ts"}},
    "typecheck": "tsc --noEmit"{{end}}
  },
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    {{if eq .Runtime "ts"}}"@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"{{end}}
  }
}
