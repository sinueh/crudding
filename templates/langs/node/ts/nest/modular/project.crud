{
  "version": 1,
  "name": "node-ts-nest-modular",
  "language": "node",
  "runtime": "ts",
  "framework": "nest",
  "architecture": "modular",
  "endpoints": [
    "catalog",
    "orders"
  ],
  "endpoint": {
    "name": "",
    "files": [],
    "register": []
  },
  "ignore": [],
  "directories": [
    "src",
    "src/modules",
    "src/modules/catalog",
    "src/modules/orders",
    "src/shared",
    "src/shared/http"
  ],
  "files": [
    ".gitignore",
    "README.md",
    "package.json",
    "src/main.ts",
    "src/modules/catalog/catalog-controller.ts",
    "src/modules/catalog/catalog-routes.ts",
    "src/modules/catalog/catalog-service.ts",
    "src/modules/catalog/index.ts",
    "src/modules/catalog/product.ts",
    "src/modules/orders/index.ts",
    "src/modules/orders/order-controller.ts",
    "src/modules/orders/order-routes.ts",
    "src/modules/orders/order-service.ts",
    "src/modules/orders/order.ts",
    "src/shared/database.ts",
    "src/shared/errors.ts",
    "src/shared/http/server.ts",
    "src/shared/http/types.ts",
    "src/shared/respond.ts",
    "tsconfig.json"
  ]
}
